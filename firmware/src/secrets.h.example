#pragma once

/* Copy this file to secrets.h and fill in local values.
 * secrets.h is gitignored and must never be committed. */

#define WIFI_SSID     "your-ssid"
#define WIFI_PASSWORD "your-password"

/* SoftAP so Navionics / OpenCPN can join the boat with no marina Wi-Fi.
 * WPA2 requires ≥ 8 characters. */
#define AP_PASSWORD   "lmycboat"

/* WordPress sailboat post id for this terminal's maintenance book.
 * 0 until the boat is assigned.
 * Baca Lele 276, Benesse 308, Chili Pepper 505, Deserata 2919,
 * Scherzando 504, Teachers Pet 506. */
#define LMYC_SAILBOAT_ID 0

/* NMEA input. A number, so this file can be included before n2k.h.
 * 0 = simulator. USB serial stays on GPIO19/20. This is the bench default.
 * 1 = NMEA 2000 listen-only. CH422G EXIO5 switches those pins to the
 *     onboard TJA1051. The log moves to the UART Type-C socket (GPIO43/44).
 * 2 = simulator until a CAN frame arrives, then the bus.
 * The onboard transceiver is not isolated. Leave the 120 Ω jumper off,
 * do not draw NET-S/NET-C power, and do not connect this header to a
 * backbone until an isolated CAN interface is fitted. See docs/05. */
#define NMEA_SOURCE 0
